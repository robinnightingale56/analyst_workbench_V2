{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uvicorn api_server.main:app --app-dir src --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "python -m compileall -q src/api_server",
    "start": "uvicorn api_server.main:app --app-dir src --host 0.0.0.0 --port ${PORT:-8080}",
    "typecheck": "python -m compileall -q src/api_server",
    "test": "pytest -q",
    "test:contract": "pytest -q",
    "test:postgres": "POSTGRES_INTEGRATION=1 pytest -q tests/test_postgres_compatibility.py",
    "test:health": "pytest -q tests/test_health.py",
    "test:concurrent": "pytest -q"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
