modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "incident-count-contract"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "analyst-review-conflict"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "analyst-workbench-build"

[[workflows.workflow]]
name = "incident-count-contract"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "analyst-review-conflict"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/analyst-workbench exec vitest run --config vitest.config.ts src/App.review-conflict.test.tsx"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "analyst-workbench-build"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/analyst-workbench run build"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

